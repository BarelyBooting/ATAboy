;
; ATAboy PIO Programs - IDE Bus Strobe Timing
;
; Two programs handle DIOR (read) and DIOW (write) strobes with precise,
; deterministic timing.  C code manages address, chip-select, and bus
; transceiver direction/enable before triggering these programs.
;
; PIO clock: at least 100 ns a cycle (ide_pio_timing.h: the divider is worked
; out from clk_sys, rounded up; 150 MHz / 15 exactly).
;
; Timing against ATA PIO mode 0 (holistic review 2026-09-26, M-2). Mode 0's
; strobe minimum t2 is 165 ns for 16-bit data but 290 ns for 8-bit register
; transfers, and every task file write is an 8-bit transfer. Until then the
; strobes were 300 ns (write) and 400 ns (read, sampled at 300 ns): 10 ns over
; the 8-bit minimum on writes. Now every figure has at least 100 ns over its
; minimum. Numbers at exactly 100 ns a cycle, WAIT on IORDY taking one cycle
; (IORDY high); tests/host/test_pio_timing.cpp works them out from this file
; and fails below these margins.
;
;   READ (DIOR-):
;     pulse width t2    : 500 ns  (290 ns min, 8-bit)      +210
;     data sampled at   : 400 ns after DIOR- falls          (a mode 0 device
;                         has 8-bit data valid by t2 - t5 = 290 - 50 = 240 ns:
;                         +160, less about 13 ns of input synchroniser)
;     high between      : 300 ns
;     cycle t0          : 800 ns  (600 ns min)              +200
;
;   WRITE (DIOW-):
;     data setup t3     : 200 ns  ( 60 ns min)              +140
;     pulse width t2    : 400 ns  (290 ns min, 8-bit)      +110
;     data hold t4      : 400 ns  ( 30 ns min)              +370
;     cycle t0          : 1000 ns (600 ns min)              +400
;
; Address and chip select (t1, 70 ns min; t9, 20 ns min) are set by the C code
; around the whole burst, microseconds away. Mode 0 gives no minimum for the
; time a strobe is high between cycles; t0 covers it.
;

; ============================================================
;  ide_read - burst DIOR strobe, pushes 16-bit words to RX FIFO
; ============================================================
; Side-set : GPIO 26 (DIOR), active-low, idles HIGH
; In pins  : GPIO 0-15 (data bus)
; TX FIFO  : push (count - 1) to start
; RX FIFO  : receives one 16-bit word per strobe
; Autopush : enabled, threshold 16

.program ide_read
.side_set 1

.wrap_target
    pull block          side 1      ; get count-1, DIOR idle HIGH
    mov y, osr          side 1

read_loop:
    nop                 side 0 [2]  ; assert DIOR   (300 ns)
    wait 1 gpio 29      side 0      ; IORDY hold    (extends pulse if needed)
    in pins, 16         side 0      ; sample data at 400 ns (DIOR still LOW)
    nop                 side 1 [1]  ; deassert DIOR (200 ns, then jmp)
    jmp y-- read_loop   side 1      ; loop or fall through
    irq wait 0 rel      side 1      ; signal done, wait for C to ack
.wrap


; ============================================================
;  ide_write - burst DIOW strobe, pulls 16-bit words from TX FIFO
; ============================================================
; Side-set : GPIO 27 (DIOW), active-low, idles HIGH
; Out pins : GPIO 0-15 (data bus)
; TX FIFO  : push (count - 1), then one data word per strobe

.program ide_write
.side_set 1

.wrap_target
    pull block          side 1      ; get count-1, DIOW idle HIGH
    mov y, osr          side 1

write_loop:
    pull block          side 1      ; get data word
    out pins, 16        side 1 [1]  ; data on bus   (200 ns setup)
    nop                 side 0 [2]  ; assert DIOW   (300 ns)
    wait 1 gpio 29      side 0      ; IORDY hold    (pulse 400 ns)
    nop                 side 1 [1]  ; deassert DIOW (200 ns, then jmp)
    jmp y-- write_loop  side 1      ; loop or fall through
    irq wait 0 rel      side 1      ; signal done, wait for C to ack
.wrap
